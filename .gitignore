Thumbs.db

# Local secrets (a documented example can be tracked)
.env
.env.*
!.env.example
*.pem
*.key

# Original/derived datasets and machine-generated absolute dataset lists
/datasets/
/configs/datasets/
/runs/
/artifacts/
/logs/
/transfers/
/recordings/

# Only model metadata belongs in Git; model binaries travel separately
/models/*
!/models/*/
/models/*/*
!/models/*/README*.md
!/models/*/model_card.json
!/models/README.md

