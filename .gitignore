# Local environments, portable utilities, caches and editor settings
/.venv/
/.tools/
/.cache/
/.ultralytics/
/.vscode/
/.idea/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
